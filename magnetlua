--========================================================--
-- CHARACTER
--========================================================--

local Character
local Humanoid
local Root

local function SetupCharacter(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid")
    Root = char:WaitForChild("HumanoidRootPart")
end

SetupCharacter(
    LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
)

LocalPlayer.CharacterAdded:Connect(function(char)
    SetupCharacter(char)
end)

--========================================================--
-- MAGNET
--========================================================--

local magnetConnection
local magnetActive = false
local dashStartTime = 0

local function StopMagnet()
    if magnetConnection then
        magnetConnection:Disconnect()
        magnetConnection = nil
    end

    magnetActive = false
end

local function GetClosestHead()
    if not Root then
        return nil
    end

    local closest
    local closestDistance = Settings.Magnet.MaxRange

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then

            local head = player.Character:FindFirstChild("Head")

            if head then
                local distance =
                    (Root.Position - head.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closest = head
                end
            end
        end
    end

    return closest
end

local function StartMagnet()

    if magnetActive then
        return
    end

    if not Settings.Magnet.Enabled then
        return
    end

    magnetActive = true

    magnetConnection = RunService.Heartbeat:Connect(function()

        if not Root or not Root.Parent then
            StopMagnet()
            return
        end

        if not Settings.Magnet.Enabled then
            StopMagnet()
            return
        end

        local target = GetClosestHead()

        if not target then
            return
        end

        local offset = target.Position - Root.Position

        if offset.Magnitude <= 0.01 then
            return
        end

        local direction = offset.Unit

        local currentVelocity =
            Root.AssemblyLinearVelocity

        local desiredSpeed = math.max(
            currentVelocity.Magnitude,
            Settings.Magnet.MinDashSpeed
        )

        local desiredVelocity =
            direction * desiredSpeed

        Root.AssemblyLinearVelocity =
            currentVelocity:Lerp(
                desiredVelocity,
                Settings.Magnet.Strength
            )

        if Humanoid.FloorMaterial == Enum.Material.Air then
            Root.AssemblyLinearVelocity =
                Root.AssemblyLinearVelocity:Lerp(
                    desiredVelocity,
                    0.88
                )
        end

        Root.CFrame =
            Root.CFrame:Lerp(
                CFrame.lookAt(
                    Root.Position,
                    target.Position
                ),
                0.25
            )

        if offset.Magnitude <= Settings.Magnet.HitDistance then
            StopMagnet()
        end
    end)
end

RunService.Heartbeat:Connect(function()

    if not Root or not Root.Parent then
        return
    end

    if not Settings.Magnet.Enabled then
        StopMagnet()
        return
    end

    local velocity = Root.AssemblyLinearVelocity
    local speed = velocity.Magnitude

    if speed < 0.01 then
        dashStartTime = 0
        return
    end

    local movingForward =
        velocity.Unit:Dot(Root.CFrame.LookVector)
        > Settings.Magnet.DirectionThreshold

    if speed >= Settings.Magnet.DashThreshold
        and movingForward then

        if dashStartTime == 0 then
            dashStartTime = tick()
        end

        if tick() - dashStartTime
            >= Settings.Magnet.MinDashTime then

            StartMagnet()
        end

    else

        dashStartTime = 0

        if magnetActive then
            StopMagnet()
        end
    end
end)


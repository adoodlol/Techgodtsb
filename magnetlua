--========================================================--
-- KEYBINDS
--========================================================--

UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.M then

        Settings.Magnet.Enabled =
            not Settings.Magnet.Enabled

        if not Settings.Magnet.Enabled then
            StopMagnet()
        end

        Rayfield:Notify({
            Title = "Dash Magnet",
            Content = Settings.Magnet.Enabled
                and "Enabled"
                or "Disabled",
            Duration = 2
        })
    end
end)


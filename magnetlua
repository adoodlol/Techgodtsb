--========================================================--
-- RAYFIELD LOADER
--========================================================--
local Rayfield
local SOURCES = {
	"https://sirius.menu/rayfield",
	"https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua",
	"https://raw.githubusercontent.com/Footagesus/Rayfield/main/source.lua",
}

if type(loadstring) ~= "function" then
	error("[Dash Magnet] loadstring is disabled — use a proper executor.")
end

for _, url in ipairs(SOURCES) do
	local ok, result = pcall(function()
		local src = game:HttpGet(url, true)
		assert(type(src) == "string" and #src > 100, "bad response")
		return loadstring(src)()
	end)
	if ok and type(result) == "table" and result.CreateWindow then
		Rayfield = result
		print("[Dash Magnet] Rayfield loaded from: " .. url)
		break
	end
	warn("[Dash Magnet] source failed: " .. url .. " | " .. tostring(result))
end

if not Rayfield then
	error("[Dash Magnet] All Rayfield sources failed.")
end


--========================================================--
-- KEYBIND
--========================================================--
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode ~= Enum.KeyCode.M then return end

	local now = tick()
	if now - state.lastToggle < 0.2 then return end
	state.lastToggle = now

	state.magnetEnabled = not state.magnetEnabled
	if not state.magnetEnabled then stopMagnet() end

	Rayfield:Notify({
		Title = "Dash Magnet",
		Content = state.magnetEnabled and "Magnet Enabled" or "Magnet Disabled",
		Duration = 2,
	})
end)


--========================================================--
-- CHARACTER REFS
--========================================================--
local Character, Humanoid, Root

local function bindCharacter(char)
	Character = char
	Humanoid  = char:WaitForChild("Humanoid", 10)
	Root      = char:WaitForChild("HumanoidRootPart", 10)
end

if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(bindCharacter)

--========================================================--
-- FORCE COLLISIONS
--========================================================--
local function forceCollisionsForCharacter(character)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			local n = part.Name
			local parent = part.Parent
			if n ~= "Handle" and n ~= "Accessory" and parent
				and not parent:IsA("Accessory") then
				part.CanCollide = true
			end
		end
	end
end

local function startCollisionEngine()
	if state.collisionConn then
		state.collisionConn:Disconnect()
		state.collisionConn = nil
	end

	local counter = 0
	state.collisionConn = RunService.Heartbeat:Connect(function()
		if not state.collisionsEnabled then return end
		counter += 1

		if counter % 3 == 0 then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character then
					forceCollisionsForCharacter(p.Character)
				end
			end
		end

		if Root and Root.Parent then
			Root.ReceiveAge = 0
			if Humanoid then Humanoid.PlatformStand = false end
		end
	end)
end

startCollisionEngine()

--========================================================--
-- MAGNET
--========================================================--
local function getClosestTarget()
	if not Root then return nil end

	local closest, closestDist = nil, CONFIG.MAX_RANGE

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local target
			if CONFIG.TARGET_PART == "Head" then
				target = p.Character:FindFirstChild("Head")
			else
				target = p.Character:FindFirstChild("HumanoidRootPart")
					or p.Character:FindFirstChild("Torso")
					or p.Character:FindFirstChild("UpperTorso")
			end
			if target then
				local d = (Root.Position - target.Position).Magnitude
				if d < closestDist then
					closestDist, closest = d, target
				end
			end
		end
	end
	return closest
end

local function stopMagnet()
	if state.magnetConn then
		state.magnetConn:Disconnect()
		state.magnetConn = nil
	end
	state.isMagnetActive = false
end

local function startMagnet()
	if state.isMagnetActive or not state.magnetEnabled then return end
	if not Root or not Root.Parent or not Humanoid then return end

	state.isMagnetActive = true

	state.magnetConn = RunService.Heartbeat:Connect(function()
		if not Root or not Root.Parent or not state.magnetEnabled then
			stopMagnet(); return
		end

		local target = getClosestTarget()
		if not target then return end

		local offset = target.Position - Root.Position
		if offset.Magnitude <= 0.01 then return end

		local direction = offset.Unit
		local currentVel = Root.AssemblyLinearVelocity
		local desiredSpeed = math.max(currentVel.Magnitude, CONFIG.MIN_DASH_SPEED)
		local desiredVel = direction * desiredSpeed

		Root.AssemblyLinearVelocity = currentVel:Lerp(desiredVel, CONFIG.MAGNET_STRENGTH)

		if Humanoid.FloorMaterial == Enum.Material.Air then
			Root.AssemblyLinearVelocity = Root.AssemblyLinearVelocity:Lerp(desiredVel, 0.88)
		end

		Root.CFrame = Root.CFrame:Lerp(CFrame.lookAt(Root.Position, target.Position), 0.25)

		if offset.Magnitude <= CONFIG.HIT_DISTANCE then
			stopMagnet()
		end
	end)
end

RunService.Heartbeat:Connect(function()
	if not Root or not Root.Parent or not state.magnetEnabled then return end

	local vel = Root.AssemblyLinearVelocity
	local speed = vel.Magnitude

	if speed < 0.01 then
		state.dashStartTime = 0
		if state.isMagnetActive then stopMagnet() end
		return
	end

	local movingForward = vel.Unit:Dot(Root.CFrame.LookVector) > CONFIG.DIRECTION_THRESHOLD

	if speed >= CONFIG.DASH_SPEED_THRESHOLD and movingForward then
		if state.dashStartTime == 0 then
			state.dashStartTime = tick()
		end
		if tick() - state.dashStartTime >= CONFIG.MIN_DASH_TIME
			and not state.isMagnetActive then
			startMagnet()
		end
	else
		state.dashStartTime = 0
		if state.isMagnetActive then stopMagnet() end
	end
end)

